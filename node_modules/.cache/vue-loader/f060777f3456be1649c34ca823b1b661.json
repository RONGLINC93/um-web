{"remainingRequest":"d:\\桌面\\开发中\\um-web\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!d:\\桌面\\开发中\\um-web\\src\\component\\PreviewTable.vue?vue&type=script&lang=js&","dependencies":[{"path":"d:\\桌面\\开发中\\um-web\\src\\component\\PreviewTable.vue","mtime":1790046646715},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1790044394353},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\babel-loader\\lib\\index.js","mtime":1790044393269},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1790044394353},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\vue-loader\\lib\\index.js","mtime":1790044414007}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["PreviewTable.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmDA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"PreviewTable.vue","sourceRoot":"src/component","sourcesContent":["<template>\r\n  <div class=\"preview-table\">\r\n    <el-table\r\n      :data=\"tableData\"\r\n      :max-height=\"maxHeight\"\r\n      style=\"width: 100%\"\r\n      @selection-change=\"handleSelectionChange\"\r\n    >\r\n      <el-table-column type=\"selection\" width=\"40\" />\r\n      <el-table-column label=\"封面\" width=\"76\">\r\n        <template slot-scope=\"scope\">\r\n          <el-image class=\"cover\" :src=\"scope.row.picture\">\r\n            <div slot=\"error\" class=\"image-slot el-image__error\">暂无封面</div>\r\n          </el-image>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"歌曲\" min-width=\"120\" show-overflow-tooltip>\r\n        <template #default=\"scope\">\r\n          <span>{{ scope.row.title }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"歌手\" min-width=\"100\" show-overflow-tooltip>\r\n        <template #default=\"scope\">\r\n          <span>{{ scope.row.artist }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"专辑\" min-width=\"120\" show-overflow-tooltip>\r\n        <template #default=\"scope\">\r\n          <span>{{ scope.row.album }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"格式\" width=\"72\">\r\n        <template #default=\"scope\">\r\n          <el-tag size=\"mini\" type=\"info\">{{ scope.row.ext.toUpperCase() }}</el-tag>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"操作\" width=\"176\">\r\n        <template #default=\"scope\">\r\n          <div class=\"ops\">\r\n            <el-button size=\"mini\" circle icon=\"el-icon-video-play\" type=\"success\" @click=\"handlePlay(scope.$index, scope.row)\" />\r\n            <el-button size=\"mini\" circle icon=\"el-icon-download\" @click=\"handleDownload(scope.row)\" />\r\n            <el-button size=\"mini\" circle icon=\"el-icon-edit\" @click=\"handleEdit(scope.row)\" />\r\n            <el-button size=\"mini\" circle icon=\"el-icon-delete\" type=\"danger\" @click=\"handleDelete(scope.$index, scope.row)\" />\r\n          </div>\r\n        </template>\r\n      </el-table-column>\r\n    </el-table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { RemoveBlobMusic } from '@/utils/utils';\r\n\r\nexport default {\r\n  name: 'PreviewTable',\r\n  props: {\r\n    tableData: { type: Array, required: true },\r\n    policy: { type: Number, required: true },\r\n    // 列表可视高度上限（px），超出后表格内部滚动，表头保持吸顶\r\n    maxHeight: { type: [Number, String], default: 440 },\r\n  },\r\n\r\n  methods: {\r\n    handleSelectionChange(val) {\r\n      this.$emit('selection-change', val);\r\n    },\r\n    handlePlay(index, row) {\r\n      // 传出整行数据，便于播放器展示封面/歌名/歌手等信息\r\n      this.$emit('play', row);\r\n    },\r\n    handleDelete(index, row) {\r\n      RemoveBlobMusic(row);\r\n      this.tableData.splice(index, 1);\r\n    },\r\n    handleDownload(row) {\r\n      this.$emit('download', row);\r\n    },\r\n    handleEdit(row) {\r\n      this.$emit('edit', row);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n// 紧凑化：缩小单元格内边距与行高\r\n// 注意：scss 中不能用 >>>（会被编译成无效的 \"> > >\"），必须用 ::v-deep\r\n.preview-table ::v-deep .el-table td,\r\n.preview-table ::v-deep .el-table th {\r\n  padding: 5px 0;\r\n}\r\n.preview-table ::v-deep .el-table .cell {\r\n  padding-left: 8px;\r\n  padding-right: 8px;\r\n  line-height: 1.4;\r\n}\r\n\r\n// 封面缩小\r\n.cover {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 4px;\r\n  display: block;\r\n}\r\n.image-slot.el-image__error {\r\n  font-size: 11px;\r\n  line-height: 1.2;\r\n  padding: 0 2px;\r\n}\r\n\r\n// 操作按钮保持一行，不换行\r\n.ops {\r\n  white-space: nowrap;\r\n  .el-button + .el-button {\r\n    margin-left: 6px;\r\n  }\r\n}\r\n</style>\r\n"]}]}