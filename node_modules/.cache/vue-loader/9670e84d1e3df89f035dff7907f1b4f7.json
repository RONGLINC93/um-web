{"remainingRequest":"d:\\桌面\\开发中\\um-web\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!d:\\桌面\\开发中\\um-web\\src\\component\\FileSelector.vue?vue&type=style&index=0&id=14101bf4&lang=scss&scoped=true&","dependencies":[{"path":"d:\\桌面\\开发中\\um-web\\src\\component\\FileSelector.vue","mtime":1790044416440},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\css-loader\\dist\\cjs.js","mtime":1790044397269},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1790044414008},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\postcss-loader\\src\\index.js","mtime":1790044406439},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\sass-loader\\dist\\cjs.js","mtime":1790044410345},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1790044394353},{"path":"d:\\桌面\\开发中\\um-web\\node_modules\\vue-loader\\lib\\index.js","mtime":1790044414007}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["FileSelector.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAyGA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"FileSelector.vue","sourceRoot":"src/component","sourcesContent":["<template>\r\n  <el-upload\r\n    :auto-upload=\"false\"\r\n    :on-change=\"addFile\"\r\n    :show-file-list=\"false\"\r\n    action=\"\"\r\n    drag\r\n    multiple\r\n    class=\"um-dropzone-upload\"\r\n  >\r\n    <div class=\"um-dropzone-inner\">\r\n      <i class=\"el-icon-upload um-dropzone-icon\" />\r\n      <div class=\"um-dropzone-title\">将加密音乐拖到此处，或 <em>点击选择</em></div>\r\n      <div class=\"um-dropzone-sub\">\r\n        支持 网易云(ncm) · QQ(qmc/mflac/mgg) · 酷狗(kgm) · 虾米(xm) · 酷我(kwm)，解密全程在本机完成\r\n      </div>\r\n    </div>\r\n    <div slot=\"tip\" class=\"um-dropzone-tip\">\r\n      <span>\r\n        仅在本机浏览器内解锁，不上传任何文件\r\n        <el-tooltip effect=\"dark\" placement=\"top-start\">\r\n          <div slot=\"content\">算法已在源代码中提供，所有运算都发生在本地</div>\r\n          <i class=\"el-icon-info\" />\r\n        </el-tooltip>\r\n      </span>\r\n      <span>\r\n        工作模式: {{ parallel ? '多线程 Worker' : '单线程 Queue' }}\r\n        <el-tooltip effect=\"dark\" placement=\"top-start\">\r\n          <div slot=\"content\">\r\n            将此工具部署在 HTTPS 环境下，可启用 Web Worker 特性，<br />\r\n            从而更快的利用并行处理完成解锁\r\n          </div>\r\n          <i class=\"el-icon-info\" />\r\n        </el-tooltip>\r\n      </span>\r\n    </div>\r\n    <transition name=\"el-fade-in\">\r\n      <el-progress\r\n        v-show=\"progress_show\"\r\n        :format=\"progress_string\"\r\n        :percentage=\"progress_value\"\r\n        :stroke-width=\"14\"\r\n        :text-inside=\"true\"\r\n        class=\"um-dropzone-progress\"\r\n      />\r\n    </transition>\r\n  </el-upload>\r\n</template>\r\n\r\n<script>\r\nimport { spawn, Worker, Pool } from 'threads';\r\nimport { Decrypt } from '@/decrypt';\r\nimport { DecryptQueue } from '@/utils/utils';\r\nimport { storage } from '@/utils/storage';\r\n\r\nexport default {\r\n  name: 'FileSelector',\r\n  data() {\r\n    return {\r\n      task_all: 0,\r\n      task_finished: 0,\r\n      queue: new DecryptQueue(), // for http or file protocol\r\n      parallel: false,\r\n    };\r\n  },\r\n  computed: {\r\n    progress_value() {\r\n      return this.task_all ? (this.task_finished / this.task_all) * 100 : 0;\r\n    },\r\n    progress_show() {\r\n      return this.task_all !== this.task_finished;\r\n    },\r\n  },\r\n  mounted() {\r\n    if (window.Worker && window.location.protocol !== 'file:' && process.env.NODE_ENV === 'production') {\r\n      console.log('Using Worker Pool');\r\n      this.queue = Pool(() => spawn(new Worker('@/utils/worker.ts')), navigator.hardwareConcurrency || 1);\r\n      this.parallel = true;\r\n    } else {\r\n      console.log('Using Queue in Main Thread');\r\n    }\r\n  },\r\n  methods: {\r\n    progress_string() {\r\n      return `${this.task_finished} / ${this.task_all}`;\r\n    },\r\n    async addFile(file) {\r\n      this.task_all++;\r\n      this.queue.queue(async (dec = Decrypt) => {\r\n        console.log('start handling', file.name);\r\n        try {\r\n          this.$emit('success', await dec(file, await storage.getAll()));\r\n        } catch (e) {\r\n          console.error(e);\r\n          this.$emit('error', e, file.name);\r\n        } finally {\r\n          this.task_finished++;\r\n        }\r\n      });\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.um-dropzone-upload {\r\n  // 放大的拖拽区\r\n  >>> .el-upload {\r\n    width: 100%;\r\n    display: block;\r\n  }\r\n  >>> .el-upload-dragger {\r\n    width: 100%;\r\n    height: auto;\r\n    padding: 52px 24px;\r\n    border: 2px dashed #409eff;\r\n    border-radius: 16px;\r\n    background: var(--um-drop-bg);\r\n    transition: border-color 0.2s ease, background 0.2s ease;\r\n    box-sizing: border-box;\r\n  }\r\n  >>> .el-upload-dragger:hover {\r\n    border-color: #85ce61;\r\n    background: var(--um-drop-bg-hover);\r\n  }\r\n  .um-dropzone-icon {\r\n    font-size: 64px;\r\n    color: #409eff;\r\n    margin: 0;\r\n  }\r\n  .um-dropzone-title {\r\n    font-size: 18px;\r\n    font-weight: 600;\r\n    color: var(--um-text-main);\r\n    margin-top: 10px;\r\n    em {\r\n      font-style: normal;\r\n      color: #409eff;\r\n    }\r\n  }\r\n  .um-dropzone-sub {\r\n    font-size: 12px;\r\n    color: var(--um-text-comment);\r\n    margin-top: 8px;\r\n    line-height: 1.5;\r\n  }\r\n  .um-dropzone-tip {\r\n    display: flex;\r\n    justify-content: center;\r\n    flex-wrap: wrap;\r\n    gap: 24px;\r\n    margin-top: 12px;\r\n    font-size: 12px;\r\n    color: var(--um-text-comment);\r\n    i {\r\n      margin-left: 4px;\r\n      font-size: 12px;\r\n    }\r\n  }\r\n  .um-dropzone-progress {\r\n    margin: 16px 6px 0;\r\n  }\r\n}\r\n</style>\r\n"]}]}