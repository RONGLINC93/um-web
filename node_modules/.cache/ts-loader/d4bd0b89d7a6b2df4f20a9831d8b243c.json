C,GAAG,WAAW,GAAG,EAA5C,EAAgD,CAAC,IAAI,WAArD,EAAkE;AACxD,YAAA,WAAW,GAAG,GAAG,CAAC,KAAJ,CAAU,CAAV,EAAa,CAAC,GAAG,WAAjB,CAAd;AACN,gBAAI,CAAC,WAAW,CAAC,KAAZ,CAAkB,cAAlB,CAAL,EAAwC;AAElC,YAAA,UAAU,GAAG,cAAc,CAAC,MAAD,EAAS,WAAT,CAA3B;AACN,gBAAI,UAAU,CAAC,KAAX,CAAiB,CAAjB,EAAoB,CAApB,EAAuB,OAAvB,CAA+B,SAA/B,CAAJ,EAA+C;AAC/C,gBAAI,UAAU,CAAC,KAAX,CAAiB,CAAjB,EAAoB,EAApB,EAAwB,OAAxB,CAAgC,eAAhC,CAAJ,EAAsD;AAGhD,YAAA,YAAY,GAAG,UAAU,CAAC,YAAX,CAAwB,IAAxB,CAAf;AACN,gBAAI,CAAC,CAAC,EAAD,EAAK,EAAL,EAAS,EAAT,EAAa,QAAb,CAAsB,YAAtB,CAAL,EAA0C;AAGpC,YAAA,oBAAoB,GAAG,OAAO,YAA9B;AACA,YAAA,SAAS,GAAG,UAAU,CAAC,KAAX,CAAiB,oBAAjB,EAAuC,oBAAoB,GAAG,CAA9D,CAAZ;AACN,gBAAI,CAAC,SAAS,CAAC,KAAV,CAAgB,oBAAhB,CAAL,EAA4C;AAEtC,YAAA,qBAAqB,GAAG,oBAAoB,GAAG,CAAvB,GAA2B,UAAU,CAAC,YAAX,CAAwB,oBAAoB,GAAG,CAA/C,CAAnD;;AACN,gBAAI,qBAAqB,IAAI,MAAM,CAAC,UAApC,EAAgD;AACtC,cAAA,eAAe,GAAG,UAAU,CAAC,KAAX,CAAiB,qBAAjB,EAAwC,qBAAqB,GAAG,CAAhE,CAAlB;AACN,kBAAI,CAAC,eAAe,CAAC,KAAhB,CAAsB,oBAAtB,CAAL,EAAkD;AACrD;;AAED,YAAA,YAAY,CAAC,IAAb,CAAkB,MAAM,CAAC,IAAP,CAAY,WAAZ,EAAyB,QAAzB,CAAkC,OAAlC,CAAlB;AACH;;AAED,cAAI,YAAY,CAAC,MAAb,IAAuB,CAA3B,EAA8B;AAC5B,kBAAM,IAAI,KAAJ,CAAU,mCAAV,CAAN;AACD;;AAEK,UAAA,aAAa,GAAG,MAAM,CAAC,IAAP,CAAY,YAAY,CAAC,CAAD,CAAxB,EAA6B,OAA7B,CAAhB;AACN,UAAA,cAAc,CAAC,GAAD,EAAM,aAAN,CAAd;AACM,UAAA,SAAS,GAAG,IAAI,IAAJ,CAAS,CAAC,GAAD,CAAT,EAAgB;AAAE,YAAA,IAAI,EAAE;AAAR,WAAhB,CAAZ;AACC,iBAAA,CAAA;AAAA;AAAA,YAAM,UAAU,CAAC,SAAD,EAAY,YAAZ,EAA0B,KAA1B,EAAiC,KAAjC,CAAhB,CAAA;;;AAAP,iBAAA,CAAA;AAAA;AAAA,YAAO,EAAA,CAAA,IAAA,EAAP,CAAA;;;;AACD","sourcesContent":["import { Decrypt as RawDecrypt } from './raw';\nimport { GetArrayBuffer } from '@/decrypt/utils';\nimport { DecryptResult } from '@/decrypt/entity';\n\nconst segmentSize = 0x20;\n\nfunction isPrintableAsciiChar(ch: number) {\n    return ch >= 0x20 && ch <= 0x7E;\n}\n\nfunction isUpperHexChar(ch: number) {\n    return (ch >= 0x30 && ch <= 0x39) || (ch >= 0x41 && ch <= 0x46);\n}\n\n/**\n * @param {Buffer} data \n * @param {Buffer} key \n * @param {boolean} copy \n * @returns Buffer\n */\nfunction decryptSegment(data: Uint8Array, key: Uint8Array) {\n    for (let i = 0; i < data.byteLength; i++) {\n      data[i] -= key[i % segmentSize];\n    }\n    return Buffer.from(data);\n}\n\nexport async function Decrypt(file: File, raw_filename: string): Promise<DecryptResult> {\n  const buf = new Uint8Array(await GetArrayBuffer(file));\n\n  // 咪咕编码的 WAV 文件有很多“空洞”内容，尝试密钥。\n  const header = buf.slice(0, 0x100);\n  const bytesRIFF = Buffer.from('RIFF', 'ascii');\n  const bytesWaveFormat = Buffer.from('WAVEfmt ', 'ascii');\n  const possibleKeys = [];\n  \n  for (let i = segmentSize; i < segmentSize * 20; i += segmentSize) {\n      const possibleKey = buf.slice(i, i + segmentSize);\n      if (!possibleKey.every(isUpperHexChar)) continue;\n  \n      const tempHeader = decryptSegment(header, possibleKey);\n      if (tempHeader.slice(0, 4).compare(bytesRIFF)) continue;\n      if (tempHeader.slice(8, 16).compare(bytesWaveFormat)) continue;\n      \n      // fmt chunk 大小可以是 16 / 18 / 40。\n      const fmtChunkSize = tempHeader.readUInt32LE(0x10);\n      if (![16, 18, 40].includes(fmtChunkSize)) continue;\n  \n      // 下一个 chunk\n      const firstDataChunkOffset = 0x14 + fmtChunkSize;\n      const chunkName = tempHeader.slice(firstDataChunkOffset, firstDataChunkOffset + 4);\n      if (!chunkName.every(isPrintableAsciiChar)) continue;\n  \n      const secondDataChunkOffset = firstDataChunkOffset + 8 + tempHeader.readUInt32LE(firstDataChunkOffset + 4);\n      if (secondDataChunkOffset <= header.byteLength) {\n          const secondChunkName = tempHeader.slice(secondDataChunkOffset, secondDataChunkOffset + 4);\n          if (!secondChunkName.every(isPrintableAsciiChar)) continue;\n      }\n  \n      possibleKeys.push(Buffer.from(possibleKey).toString('ascii'));\n  }\n  \n  if (possibleKeys.length <= 0) {\n    throw new Error(`ERROR: no suitable key discovered`);\n  }\n  \n  const decryptionKey = Buffer.from(possibleKeys[0], 'ascii');\n  decryptSegment(buf, decryptionKey);\n  const musicData = new Blob([buf], { type: 'audio/x-wav' });\n  return await RawDecrypt(musicData, raw_filename, 'wav', false);\n}\n"],"sourceRoot":""}]}