AACyC,iBAAA,CAAA;AAAA;AAAA,YAAM,kBAAkB,CACrE,IAAI,IAAJ,CAAS,CAAC,YAAD,CAAT,EAAyB;AAAE,YAAA,IAAI,EAAE;AAAR,WAAzB,CADqE,EAErE,YAFqE,EAGrE,GAHqE,EAIrE,MAJqE,CAAxB,CAAA;;;AAAzC,UAAA,EAAA,GAAyC,EAAA,CAAA,IAAA,EAAzC,EAAE,KAAK,GAAA,EAAA,CAAA,KAAP,EAAS,MAAM,GAAA,EAAA,CAAA,MAAf,EAAiB,MAAM,GAAA,EAAA,CAAA,MAAvB,EAAyB,IAAI,GAAA,EAAA,CAAA,IAA7B,EAA+B,KAAK,GAAA,EAAA,CAAA,KAApC;AAON,iBAAA,CAAA;AAAA;AAAA,YAAO;AACL,YAAA,KAAK,EAAE,KADF;AAEL,YAAA,MAAM,EAAE,MAFH;AAGL,YAAA,GAAG,EAAE,GAHA;AAIL,YAAA,KAAK,EAAE,KAJF;AAKL,YAAA,OAAO,EAAE,MALJ;AAML,YAAA,IAAI,EAAE,GAAG,CAAC,eAAJ,CAAoB,IAApB,CAND;AAOL,YAAA,IAAI,EAAE,IAPD;AAQL,YAAA,IAAI,EAAE;AARD,WAAP,CAAA;;;;AAUD","sourcesContent":["import jooxFactory from '@unlock-music/joox-crypto';\n\nimport { DecryptResult } from './entity';\nimport { AudioMimeType, GetArrayBuffer, SniffAudioExt } from './utils';\n\nimport { MergeUint8Array } from '@/utils/MergeUint8Array';\nimport { storage } from '@/utils/storage';\nimport { extractQQMusicMeta } from '@/utils/qm_meta';\n\nexport async function Decrypt(file: Blob, raw_filename: string, raw_ext: string): Promise<DecryptResult> {\n  const uuid = await storage.loadJooxUUID('');\n  if (!uuid || uuid.length !== 32) {\n    throw new Error('请在“解密设定”填写应用 Joox 应用的 UUID。');\n  }\n\n  const fileBuffer = new Uint8Array(await GetArrayBuffer(file));\n  const decryptor = jooxFactory(fileBuffer, uuid);\n  if (!decryptor) {\n    throw new Error('不支持的 joox 加密格式');\n  }\n\n  const musicDecoded = MergeUint8Array(decryptor.decryptFile(fileBuffer));\n  const ext = SniffAudioExt(musicDecoded);\n  const mime = AudioMimeType[ext];\n\n  const songId = raw_filename.match(/^(\\d+)\\s\\[mqms\\d*]$/i)?.[1];\n  const { album, artist, imgUrl, blob, title } = await extractQQMusicMeta(\n    new Blob([musicDecoded], { type: mime }),\n    raw_filename,\n    ext,\n    songId,\n  );\n\n  return {\n    title: title,\n    artist: artist,\n    ext: ext,\n    album: album,\n    picture: imgUrl,\n    file: URL.createObjectURL(blob),\n    blob: blob,\n    mime: mime,\n  };\n}\n"],"sourceRoot":""}]}